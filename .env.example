# ============================================================
# Binance Spot Testnet Trading Bot - configuration template
# ============================================================
# NOTE: this file is the SINGLE SOURCE OF TRUTH - its values always override
# stale variables inherited from the shell (conflicts are logged at startup),
# so the bot can never silently drift into demo mode or stop itself.
# HOW TO SET UP THE TESTNET API KEYS
# ----------------------------------
# 1. Log in (or create an account) on Binance and open the Spot Testnet site:
#        https://testnet.binance.vision/
# 2. Click "Generate HMAC SHA256 key". Copy the API key and the secret.
# 3. (Optional but recommended) Click "Request testnet funds" so your test
#    wallet receives fake BTC/USDT balances. They have no real value.
# 4. Copy this file to ".env" (same folder as trading_bot.py) and paste your
#    two values below. NEVER use your real mainnet API keys here.

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Market & strategy -------------------------------------------------------
# Trading pair (ccxt unified notation).
SYMBOL=BTC/USDT
# Candle timeframe: 1s, 1m, 3m, 5m, 15m, 1h, 4h, 1d ... (defaults to 5m).
TIMEFRAME=5m
# EMA crossover periods. BUY when EMA fast crosses ABOVE EMA slow, SELL on the
# opposite. EMA reacts faster than the old SMA(7,25).
EMA_FAST_PERIOD=8
EMA_SLOW_PERIOD=21
# RSI lookback period (printed for information, not used for signals).
RSI_PERIOD=14
# ADX (Average Directional Index) trend filter. New BUY entries are only allowed
# when the market is trending: ADX must be strictly above ADX_THRESHOLD.
# 25 filters weak trends, chop and fakeout crosses (20 is the textbook value).
ADX_PERIOD=14
ADX_THRESHOLD=25
# Signals are read from COMPLETED candles only. The newest candle is still
# forming while the bot polls, so a crossover inside it can still disappear
# ("repainting") - with true, an entry only happens on a confirmed cross.
SIGNAL_ON_CLOSED_CANDLE=true

# --- Risk management (automatic TP / SL) --------------------------------------
# Hard price limits applied to the entry price of every open position. The bot
# closes the position automatically as soon as the LIVE price hits either level,
# even in the middle of a candle - in addition to the opposite EMA cross.
# +2.5% / -1.0% leaves ~+2.20% / -1.30% after two 0.1% taker fees and ~5 bps of
# slippage per side, i.e. an R:R of ~1.7 (the startup log prints the exact
# numbers for your symbol and account).
TAKE_PROFIT_PCT=2.5   # close when price rises +2.5% from entry
STOP_LOSS_PCT=1.0     # close when price falls -1.0% from entry
# Estimated market-order slippage per side (%), used for the net reward/risk
# report and for the dust-risk estimate.
SLIPPAGE_PCT=0.05

# --- Position sizing (exchange minimums on a small balance) -------------------
# Amount of quote currency (USDT) spent on each market BUY.
# The bot floors the quantity to the symbol's lot step, bumps it up by ONE step
# when that flooring would break minNotional (only if the balance can pay for
# it) and otherwise SKIPS the trade with an exact "you need X USDT" message.
# A pair whose minNotional is 10 USDT needs ~10.12 USDT to trade a -1.0% stop,
# so on BTC/USDT the budget must be slightly above the minNotional; the startup
# log prints "safe minimum account" for the configured symbol.
ORDER_SIZE_QUOTE=10
# Extra headroom on top of minNotional (%) for the entry. 0 = allow an order
# exactly on the exchange minimum; raise it (e.g. 2) on a bigger account so a
# price tick between sizing and the exchange check cannot reject the order.
MIN_NOTIONAL_BUFFER_PCT=0.0
# true  -> refuse an entry whose stop-loss exit would fall below minNotional
#          (Binance rejects such a sell as unsellable dust).
# false -> accept it and warn instead (lets a 10 USDT account still trade).
REQUIRE_EXIT_VIABLE=false
# Number of candles used to compute the indicators (EMA/RSI/ADX warm-up).
CANDLE_LIMIT=150

# --- Account protection (risk caps for a small balance; 0 = disabled) ---------
# Stop opening new positions after this much realised loss within one UTC day,
# in % of the day's starting equity. Already open positions stay protected -
# TP/SL exits are NEVER blocked by any of these gates.
MAX_DAILY_LOSS_PCT=3.0
# Pause new entries after N losing trades in a row (lifted at the next UTC day).
MAX_CONSECUTIVE_LOSSES=3
# ...and stay flat for this many candles after a STOP-LOSS exit, so the bot does
# not immediately re-enter the same chop that just stopped it out.
LOSS_COOLDOWN_CANDLES=2
# Sell only the quantity the bot actually bought, so a pre-existing balance
# (e.g. testnet faucet BTC) is never touched. After a restart the tracked
# quantity is unknown and the full free balance is sold, so a real position can
# always be closed.
SELL_ONLY_TRACKED_QTY=true

# --- Balance & fees (validated against a 10 USDT testnet account) --------------
# Starting balance in DEMO / mock mode (local simulation only).
INITIAL_BALANCE_USDT=10.0
# Simulated Binance Spot taker fee (0.1% = 0.001) applied to paper fills in DEMO
# mode, so the balance and leftover dust behave like the real account.
FEE_RATE=0.001

# --- Loop behaviour ----------------------------------------------------------
# How often (seconds) the strategy iterates.
POLL_SECONDS=30
# true  -> local simulation, no API keys needed, nothing touches the network.
# false -> real Spot Testnet ("paper money" at testnet.binance.vision).
DEMO_MODE=false
# TEST-ONLY: stop automatically after N seconds when DEMO_MODE=true (0 = off).
# IGNORED in production mode - the bot always runs 24/7 until you press Ctrl+C.
RUN_FOR_SECONDS=0
# Terminal verbosity: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# --- Telegram notifications (optional) ---------------------------------------
# The bot pushes a message on startup, on every BUY/SELL order (with P/L when
# a position closes) and on critical errors / network problems. Leave both
# empty to disable notifications entirely.
#
# How to get the two values:
#   1. In Telegram, talk to @BotFather  ->  /newbot  ->  copy the bot token.
#   2. IMPORTANT: open your new bot chat and press START (or send it any
#      message) - Telegram blocks bots from messaging you first.
#   3. Find your chat id: message @userinfobot, or open
#         https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      in a browser after messaging your bot and read "chat":{"id":123...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram retry behaviour (optional; defaults shown) ----------------------
# Every message is first tried up to TELEGRAM_MAX_ATTEMPTS times, waiting
# TELEGRAM_RETRY_DELAYS seconds between attempts (comma separated). If all of
# them fail (no internet, connection timeout, DNS error, ...) the message is
# put into a background queue that re-sends it every TELEGRAM_QUEUE_RETRY_SECONDS
# for up to TELEGRAM_QUEUE_MAX_AGE seconds - without ever blocking or crashing
# the trading loop. Notifications are therefore not lost during a short outage.
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_DELAYS=2,4
TELEGRAM_QUEUE_RETRY_SECONDS=30
TELEGRAM_QUEUE_MAX_AGE=1800