# ============================================================
# Binance Spot Testnet Trading Bot - configuration template
# ============================================================
# NOTE: this file is the SINGLE SOURCE OF TRUTH - its values always override
# stale variables inherited from the shell (conflicts are logged at startup),
# so the bot can never silently drift into demo mode or stop itself.
# HOW TO SET UP THE TESTNET API KEYS
# ----------------------------------
# 1. Log in (or create an account) on Binance and open the Spot Testnet site:
#        https://testnet.binance.vision/
# 2. Click "Generate HMAC SHA256 key". Copy the API key and the secret.
# 3. (Optional but recommended) Click "Request testnet funds" so your test
#    wallet receives fake BTC/USDT balances. They have no real value.
# 4. Copy this file to ".env" (same folder as trading_bot.py) and paste your
#    two values below. NEVER use your real mainnet API keys here.

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Market & strategy -------------------------------------------------------
# Trading pair (ccxt unified notation).
SYMBOL=BTC/USDT
# Candle timeframe: 1s, 1m, 3m, 5m, 15m, 1h, 4h, 1d ... (defaults to 5m).
TIMEFRAME=5m
# EMA crossover periods. BUY when EMA fast crosses ABOVE EMA slow, SELL on the
# opposite. EMA reacts faster than the old SMA(7,25).
EMA_FAST_PERIOD=8
EMA_SLOW_PERIOD=21
# RSI lookback period (logged on every tick and used by the optional
# RSI_MAX_ENTRY / RSI_MIN_ENTRY entry filter further down).
RSI_PERIOD=14
# ADX (Average Directional Index) trend filter. New BUY entries are only allowed
# when the market is trending: ADX must be strictly above ADX_THRESHOLD.
# 25 filters weak trends, chop and fakeout crosses (20 is the textbook value).
ADX_PERIOD=14
ADX_THRESHOLD=25
# Signals are read from COMPLETED candles only. The newest candle is still
# forming while the bot polls, so a crossover inside it can still disappear
# ("repainting") - with true, an entry only happens on a confirmed cross.
SIGNAL_ON_CLOSED_CANDLE=true

# --- Risk management (automatic TP / SL / trailing stop) -----------------------
# Hard price limits applied to the entry price of every open position. The bot
# closes the position automatically as soon as the LIVE price hits either level,
# even in the middle of a candle - in addition to the opposite EMA cross.
# With DCA enabled the stop must sit BELOW the DCA trigger (DCA_DROP_PERCENT),
# otherwise the trade is closed before it can ever average down.
TAKE_PROFIT_PCT=2.5   # close when price rises +2.5% from entry
STOP_LOSS_PCT=2.5     # close when price falls -2.5% from entry
# Trailing stop (%): while the price rises the hard stop-loss is dragged up
# behind it, locking in profit; the position closes when the price drops this
# far from its post-entry peak. 0 = classic fixed stop-loss only.
TRAILING_STOP_PCT=1.0
# The trail only ARMS after the peak climbed this many % above the (current
# average) entry. That keeps it a pure profit-lock: a straight decline is
# handled by the DCA / stop-loss rules instead of a 1% "trail" exit.
TRAILING_ARM_PCT=0.5
# Estimated market-order slippage per side (%), used for the net reward/risk
# report and for the dust-risk estimate.
SLIPPAGE_PCT=0.05

# --- DCA (average down instead of an immediate stop-out) ----------------------
# When a position drops DCA_DROP_PERCENT below its *current average* entry, the
# bot buys DCA_SIZE_QUOTE more of that coin instead of being stopped out on the
# spot. The average entry - and with it the TP/SL levels - is recomputed, so the
# trade gets room to recover. Guard rails:
#   * at most DCA_MAX_ENTRIES adds (and at most one per candle),
#   * NEVER once the price already broke the hard stop-loss,
#   * never past DCA_MAX_POSITION_QUOTE (per-coin exposure cap; 0 = only the free
#     balance limits it) and never past the free quote balance,
#   * every add is lot/minNotional checked exactly like the first entry.
# Take-profit and trailing-stop exits always win over DCA. Remember that +1 DCA
# roughly doubles the risk of that trade: keep DCA_MAX_POSITION_QUOTE and
# STOP_LOSS_PCT aligned with the account size.
DCA_ENABLED=true
DCA_DROP_PERCENT=1.5
DCA_SIZE_QUOTE=10      # quote per add; 0 = reuse ORDER_SIZE_QUOTE / the slot size
DCA_MAX_ENTRIES=2
DCA_MAX_POSITION_QUOTE=30

# --- RSI entry filter (optional, on top of the ADX trend filter; 0 = off) ------
# RSI_MAX_ENTRY refuses a BUY when RSI is above it (75 = do not chase a blow-off
# top), RSI_MIN_ENTRY when RSI is below it. Exits and the DCA are never gated.
RSI_MAX_ENTRY=75
RSI_MIN_ENTRY=0

# --- Position sizing (a 50 USDT test balance) ---------------------------------
# Amount of quote currency (USDT) spent on each market BUY: 50 USDT / 5 slots =
# 10 USDT, which clears every minNotional and still leaves a reserve for DCA.
# The bot floors the quantity to the symbol's lot step, bumps it up by ONE step
# when that flooring would break minNotional (only if the balance can pay for
# it) and otherwise SKIPS the trade with an exact "you need X USDT" message.
# A pair whose minNotional is 10 USDT needs ~10.3 USDT to trade a -2.5% stop,
# so on BTC/USDT the budget must be above the minNotional; the startup log
# prints "safe minimum account" for the configured symbol.
ORDER_SIZE_QUOTE=10
# Extra headroom on top of minNotional (%) for the entry. 0 = allow an order
# exactly on the exchange minimum; raise it (e.g. 2) on a bigger account so a
# price tick between sizing and the exchange check cannot reject the order.
MIN_NOTIONAL_BUFFER_PCT=0.0
# true  -> refuse an entry whose stop-loss exit would fall below minNotional
#          (Binance rejects such a sell as unsellable dust).
# false -> accept it and warn instead (lets a 10 USDT account still trade).
REQUIRE_EXIT_VIABLE=false
# Number of candles used to compute the indicators (EMA/RSI/ADX warm-up).
CANDLE_LIMIT=150

# --- Account protection (risk caps for a small balance; 0 = disabled) ---------
# Stop opening new positions after this much realised loss within one UTC day,
# in % of the day's starting equity. Already open positions stay protected -
# TP/SL exits are NEVER blocked by any of these gates.
MAX_DAILY_LOSS_PCT=3.0
# Pause new entries after N losing trades in a row (lifted at the next UTC day).
MAX_CONSECUTIVE_LOSSES=3
# ...and stay flat for this many candles after a STOP-LOSS exit, so the bot does
# not immediately re-enter the same chop that just stopped it out.
LOSS_COOLDOWN_CANDLES=2
# Sell only the quantity the bot actually bought, so a pre-existing balance
# (e.g. testnet faucet BTC) is never touched. After a restart the tracked
# quantity is unknown and the full free balance is sold, so a real position can
# always be closed.
SELL_ONLY_TRACKED_QTY=true

# --- Balance & fees (a 50 USDT test balance) -----------------------------------
# Starting balance in DEMO / mock mode (local simulation only). 50.00 USDT is the
# balance this configuration is tuned for.
INITIAL_BALANCE_USDT=50.0
# Simulated Binance Spot taker fee (0.1% = 0.001) applied to paper fills in DEMO
# mode, so the balance and leftover dust behave like the real account.
FEE_RATE=0.001

# --- Multi-coin / coin-list scanner (optional, async) -------------------------
# Set SCAN_ENABLED=true (or run with --scan / --multi / --all-pairs) to turn the
# bot into a portfolio scanner: it polls the coins in SCANNER_SYMBOLS one after
# another and trades every one that shows an active BUY setup, each with its own
# *proportional* slice of the free balance. Empty list = discover every liquid
# SPOT pair quoted in SCAN_QUOTE.
SCAN_ENABLED=true
# Quote currency every scanned pair shares (USDT is the high-volume default).
SCAN_QUOTE=USDT
# Split the deployable balance into this many equal position budgets. With the
# 50 USDT test balance, 5 parts -> 10 USDT per entry: far above minNotional.
PORTFOLIO_PARTS=5
# Absolute floor (USDT) per budget slot. On a $10 account a slot floored to
# minNotional (~10) yields ONE safe slot instead of 5 dust orders Binance would
# reject; on $50 you get four properly-sized slots plus a DCA reserve. 0 = let
# minNotional decide (still respects each pair's minNotional).
PORTFOLIO_FLOOR_USDT=10
# Only scan spot pairs that traded at least this much quote currency in 24h.
SCAN_MIN_24H_QUOTE=100000
# Cap on how many pairs are scanned per cycle (keeps the API rate-limiter happy).
SCAN_MAX_SYMBOLS=30
# Comma-separated symbols to NEVER trade, e.g. "SHIB/USDT,DOGE/USDT".
SCAN_EXCLUDE=
# The coin list to trade. The scanner polls these coins in this order every
# SCAN_POLL_SECONDS and enters every one that shows an active BUY setup (EMA
# golden cross + ADX trend filter + RSI filter). ccxt notation is used, but a
# plain "BTCUSDT" / "BTC-USDT" is accepted too. Empty = dynamic discovery.
SCANNER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT
# Max share (%) of the free balance deployable across the whole portfolio at
# once. 80% keeps ~10 USDT of the 50 USDT balance free for DCA adds and fees.
USE_ALL_BALANCE_PCT=80
# Poll interval (seconds) between scanner cycles (independent of POLL_SECONDS).
SCAN_POLL_SECONDS=60
# Binance BNB-fee-discount (0..25): holding BNB cuts the taker fee by up to 25%.
# Used for the net reward/risk report and sizing so numbers match a BNB account.
BNB_FEE_DISCOUNT_PCT=0

# --- Loop behaviour ----------------------------------------------------------
# How often (seconds) the strategy iterates.
POLL_SECONDS=30
# true  -> local simulation, no API keys needed, nothing touches the network.
# false -> real Spot Testnet ("paper money" at testnet.binance.vision).
DEMO_MODE=false
# TEST-ONLY: stop automatically after N seconds when DEMO_MODE=true (0 = off).
# IGNORED in production mode - the bot always runs 24/7 until you press Ctrl+C.
RUN_FOR_SECONDS=0
# Terminal verbosity: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# --- Telegram notifications (optional) ---------------------------------------
# The bot pushes a message on startup, on every BUY/SELL order (with P/L when
# a position closes) and on critical errors / network problems. Leave both
# empty to disable notifications entirely.
#
# How to get the two values:
#   1. In Telegram, talk to @BotFather  ->  /newbot  ->  copy the bot token.
#   2. IMPORTANT: open your new bot chat and press START (or send it any
#      message) - Telegram blocks bots from messaging you first.
#   3. Find your chat id: message @userinfobot, or open
#         https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      in a browser after messaging your bot and read "chat":{"id":123...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram retry behaviour (optional; defaults shown) ----------------------
# Every message is first tried up to TELEGRAM_MAX_ATTEMPTS times, waiting
# TELEGRAM_RETRY_DELAYS seconds between attempts (comma separated). If all of
# them fail (no internet, connection timeout, DNS error, ...) the message is
# put into a background queue that re-sends it every TELEGRAM_QUEUE_RETRY_SECONDS
# for up to TELEGRAM_QUEUE_MAX_AGE seconds - without ever blocking or crashing
# the trading loop. Notifications are therefore not lost during a short outage.
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_DELAYS=2,4
TELEGRAM_QUEUE_RETRY_SECONDS=30
TELEGRAM_QUEUE_MAX_AGE=1800